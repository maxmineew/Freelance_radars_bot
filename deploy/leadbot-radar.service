[Unit]
Description=LeadBot: live Telegram lead radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leadbot
WorkingDirectory=/opt/leadbot
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/leadbot/venv/bin/python -u -m leadbot.radar
Restart=on-failure
RestartSec=15
TimeoutStopSec=360
KillMode=mixed

[Install]
WantedBy=multi-user.target
